# Organization variables (not secret).
# Leave a value empty to skip it.
DEB_S3_BUCKET=
DEB_S3_PREFIX=
DEB_S3_CODENAME=
DEB_S3_COMPONENT=
DEB_S3_REGION=
DEB_S3_ENDPOINT=
DEB_S3_FORCE_PATH_STYLE=
DEB_S3_SIGN_KEY=
DEB_S3_CLEAN=
DEB_S3_ORIGIN=
DEB_S3_SUITE=
DEB_S3_PRESERVE_VERSIONS=
DEB_S3_LOCK=
DEB_S3_FAIL_IF_EXISTS=
DEB_S3_VISIBILITY=
DEB_S3_USE_SESSION_TOKEN=
DEB_S3_GPG_PROVIDER=

# Organization secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DEB_REPO_SIGNING_PASSPHRASE=

# The signing key is kept in a separate file and base64-encoded by
# load-org-credentials.sh, so the multiline key never has to live in this
# dotenv file. Relative paths are resolved from this file's directory.
DEB_REPO_SIGNING_PRIVATE_KEY_FILE=./repository-signing-private.asc

# Alternatively, put a single-line base64 key here instead of the _FILE line:
# DEB_REPO_SIGNING_PRIVATE_KEY=
